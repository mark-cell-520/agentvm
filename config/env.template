# Template for the guest agent's ~/.hermes/.env
#
# Copy to a private location, fill in, and pass with:
#   scripts/50-configure.sh --vm agent \
#       --llm-key-file /path/to/key --llm-base-url https://api.example.com/v1 \
#       --llm-model Model-Name \
#       --feishu-app-id cli_xxx --feishu-app-secret-file /path/to/secret
#
# The scripts read secrets from FILES, never from argv: anything in argv lands in
# the host process table, and anything retyped from a chat log may have been
# silently mangled by a redaction layer.

# --- LLM provider ----------------------------------------------------------
# An OpenAI-compatible endpoint. Names below match the MiniMax China build;
# rename if your build expects different variables.
MINIMAX_CN_API_KEY=
MINIMAX_CN_BASE_URL=https://api.minimax.cn/v1

# --- Feishu / Lark ---------------------------------------------------------
# FEISHU_APP_ID is not secret; the SECRET is, and goes in its own file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu = open.feishu.cn (China), lark = open.larksuite.com (international)
FEISHU_DOMAIN=feishu
# websocket needs no public URL and works behind NAT. Do not change to webhook
# unless you have a reachable endpoint.
FEISHU_CONNECTION_MODE=websocket

# --- access control --------------------------------------------------------
# Leave FEISHU_ALLOW_ALL_USERS unset in production. Set FEISHU_ALLOWED_USERS to a
# comma-separated list of open_ids instead. allow-all means anyone in your Feishu
# tenant who can find the app can drive the agent — and if you have also disabled
# approval prompts, that means anyone can run arbitrary commands in the VM.
# FEISHU_ALLOWED_USERS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_ALLOW_ALL_USERS=true

# --- permissions -----------------------------------------------------------
# Set to 1 to bypass approval prompts. Two independent mechanisms, both applied:
#   HERMES_YOLO_MODE       read at import time (put it in the systemd unit too)
#   approvals.mode: off    read at call time, more reliable
# Note that hardline safety blocks are enforced BEFORE this gate and are not
# bypassed by either setting.
# HERMES_YOLO_MODE=1
