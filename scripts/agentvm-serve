#!/usr/bin/env bash
# agentvm-serve — run the local OCI registry in the foreground (Ctrl+C to stop).
#
# Wraps scripts/lib/oci-registry.py so you don't have to remember the paths.

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$HERE/../lib/common.sh"

PORT="${LOCAL_REGISTRY_PORT}"
IMAGE_DIR="$AGENTVM_HOME/image"

while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --dir) IMAGE_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

need_cmd python3
[ -d "$IMAGE_DIR" ] || die "no image directory at $IMAGE_DIR — run agentvm-fetch first"

exec python3 "$HERE/lib/oci-registry.py" "$IMAGE_DIR" "$PORT" --repo "$LOCAL_REPO_NAME"
